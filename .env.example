# Nexus Lens environment configuration
# Copy to .env and fill with real values.

# --- Application ---
APP_ENV=development
# Bind address (demo mode binds 127.0.0.1 only)
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./nexus_lens.db

# --- LLM (opt-in, advisory only) ---
# The deterministic engine does not require these.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# --- Keycloak (planned) ---
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_URL=